<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.moodyfin.helper" name="MoodyFin Helper" version="0.8.0" provider-name="moodyjim">
  <requires>
    <import addon="xbmc.python" version="3.0.1"/>
    <!-- blur for the ambient background; without it the skin shows the plain picture, dimmed -->
    <import addon="script.module.pil" version="5.1.0" optional="true"/>
  </requires>
  <!-- actions the skin runs: RunScript(script.moodyfin.helper,action=...). Must stay first. -->
  <extension point="xbmc.python.script" library="script.py"/>
  <!-- Home rows: plugin://script.moodyfin.helper/?row=... -->
  <extension point="xbmc.python.pluginsource" library="plugin.py">
    <provides>video</provides>
  </extension>
  <!-- library stats, row refresh, ambient background -->
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Helper for the MoodyFin skin</summary>
    <description lang="en_GB">Builds MoodyFin's Home rows, library stats and the blurred background. The skin needs it.</description>
    <platform>all</platform>
    <license>MIT</license>
    <source>https://github.com/moodyjim/moodyfin</source>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
  </extension>
</addon>
