<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.moodyfin" name="MoodyFin Repository" version="1.0.0" provider-name="moodyjim">
  <extension point="xbmc.addon.repository" name="MoodyFin Repository">
    <dir>
      <info compressed="false">https://moodyjim.github.io/moodyfin/addons.xml</info>
      <checksum>https://moodyjim.github.io/moodyfin/addons.xml.md5</checksum>
      <datadir zip="true">https://moodyjim.github.io/moodyfin/</datadir>
      <hashes>false</hashes>
