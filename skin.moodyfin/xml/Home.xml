<?xml version="1.0" encoding="UTF-8"?>
<!-- MoodyFin Home: the Jellyfin theme's home page.
     Ambient background, header (9100 nav, 9120 profile), then one scrolling column (9000):
       9200 hero (8000 is its hidden item list), 9300 studios, 401 Continue Watching & Next Up, 402 Top 10,
       403 Latest Releases, 404 Recently Added Movies, 405 Recently Added Shows.
     Rows come from script.moodyfin.helper (plugin://script.moodyfin.helper/?row=...). -->
<window>
	<defaultcontrol always="true">9201</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<controls>
		<include>MFAmbient</include>

		<!-- hero items: invisible list that holds the hero titles. Play / More info focus it and send Select / Info,
		     so Kodi handles resume, shows and the info dialog itself. -->
		<control type="list" id="8000">
			<left>0</left><top>-10</top><width>10</width><height>1</height>
			<orientation>horizontal</orientation>
			<scrolltime>0</scrolltime>
			<autoscroll time="9000" delay="9000">!Window.IsActive(movieinformation) + !Control.HasFocus(8000)</autoscroll>
			<onup>9100</onup>
			<ondown>9300</ondown>
			<onback>9201</onback>
			<itemlayout width="10" height="1" />
			<focusedlayout width="10" height="1" />
			<content>plugin://script.moodyfin.helper/?row=hero&amp;reload=$INFO[Window(Home).Property(MoodyFin.Reload)]</content>
		</control>

		<control type="grouplist" id="9000">
			<left>0</left><top>0</top><width>100%</width><height>4000</height>
			<orientation>vertical</orientation>
			<itemgap>0</itemgap>
			<onup>9100</onup>
			<!-- TV-style scrolling: the focused row slides up to just under the header (y 110). Each animation stands
			     for one block above the focused row and only counts when that block is shown; they add up. -->
			<animation effect="slide" end="0,-850" time="320" tween="cubic" easing="out" condition="Control.IsVisible(9200) + [ControlGroup(4010).HasFocus | ControlGroup(4020).HasFocus | ControlGroup(4030).HasFocus | ControlGroup(4040).HasFocus | ControlGroup(4050).HasFocus]">Conditional</animation>
			<animation effect="slide" end="0,-60" time="320" tween="cubic" easing="out" condition="ControlGroup(4010).HasFocus | ControlGroup(4020).HasFocus | ControlGroup(4030).HasFocus | ControlGroup(4040).HasFocus | ControlGroup(4050).HasFocus">Conditional</animation>
			<animation effect="slide" end="0,-360" time="320" tween="cubic" easing="out" condition="Control.IsVisible(4010) + [ControlGroup(4020).HasFocus | ControlGroup(4030).HasFocus | ControlGroup(4040).HasFocus | ControlGroup(4050).HasFocus]">Conditional</animation>
			<animation effect="slide" end="0,-400" time="320" tween="cubic" easing="out" condition="Control.IsVisible(4020) + [ControlGroup(4030).HasFocus | ControlGroup(4040).HasFocus | ControlGroup(4050).HasFocus]">Conditional</animation>
			<animation effect="slide" end="0,-460" time="320" tween="cubic" easing="out" condition="Control.IsVisible(4030) + [ControlGroup(4040).HasFocus | ControlGroup(4050).HasFocus]">Conditional</animation>
			<animation effect="slide" end="0,-460" time="320" tween="cubic" easing="out" condition="Control.IsVisible(4040) + [ControlGroup(4050).HasFocus]">Conditional</animation>
			<animation effect="fade" start="0" end="100" time="300">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>

			<!-- ======================================================== hero -->
			<control type="group" id="9200">
				<defaultcontrol always="true">9201</defaultcontrol>
				<onup>9100</onup>
				<ondown>9300</ondown>
				<height>850</height>
				<visible>Integer.IsGreater(Container(8000).NumItems,0) | Container(8000).IsUpdating</visible>
				<control type="image">
					<left>0</left><top>0</top><width>100%</width><height>1100</height>
					<aspectratio>stretch</aspectratio>
					<fadetime>500</fadetime>
					<texture background="true" diffuse="moodyfin/masks/hero.png">$INFO[Container(8000).ListItem.Art(fanart)]</texture>
				</control>
				<control type="image">
					<left>0</left><top>0</top><width>1200</width><height>1080</height>
					<texture colordiffuse="A6000000">moodyfin/shapes/grad_left.png</texture>
				</control>
				<!-- title logo, or the title in Bebas -->
				<control type="image">
					<left>mf_gutter</left><top>330</top><width>680</width><height>230</height>
					<aspectratio align="left" aligny="bottom">keep</aspectratio>
					<fadetime>300</fadetime>
					<texture background="true">$INFO[Container(8000).ListItem.Art(clearlogo)]</texture>
				</control>
				<control type="label">
					<left>mf_gutter</left><top>330</top><width>1100</width><height>230</height>
					<aligny>bottom</aligny>
					<font>mf_heading120</font>
					<textcolor>mf_text</textcolor>
					<label>$INFO[Container(8000).ListItem.Label]</label>
					<visible>String.IsEmpty(Container(8000).ListItem.Art(clearlogo))</visible>
				</control>
				<!-- ★ 6.7 · 2026 · Movie · Romance / Drama -->
				<control type="label">
					<left>mf_gutter</left><top>578</top><width>1100</width><height>40</height>
					<aligny>center</aligny>
					<font>mf_semibold25</font>
					<textcolor>mf_text</textcolor>
					<label>$INFO[Container(8000).ListItem.Property(mf.meta)]</label>
				</control>
				<control type="textbox">
					<left>mf_gutter</left><top>628</top><width>880</width><height>96</height>
					<font>font12</font>
					<textcolor>E6F1F2F4</textcolor>
					<label>$INFO[Container(8000).ListItem.Plot]</label>
				</control>
				<!-- Play / More info -->
				<control type="group">
					<left>mf_gutter</left><top>762</top>
					<control type="button" id="9201">
						<left>0</left><top>0</top><width>178</width><height>64</height>
						<label />
						<texturefocus border="32,0,32,0" colordiffuse="mf_text">moodyfin/shapes/pill_64.png</texturefocus>
						<texturenofocus border="32,0,32,0" colordiffuse="99101113">moodyfin/shapes/pill_64.png</texturenofocus>
						<onclick>SetFocus(8000)</onclick>
						<onclick>Action(Select)</onclick>
						<onleft>Control.Move(8000,-1)</onleft>
						<onright>9202</onright>
						<onup>9100</onup>
						<ondown>9300</ondown>
					</control>
					<control type="button" id="9202">
						<left>192</left><top>0</top><width>232</width><height>64</height>
						<label />
						<texturefocus border="32,0,32,0" colordiffuse="mf_text">moodyfin/shapes/pill_64.png</texturefocus>
						<texturenofocus border="32,0,32,0" colordiffuse="99101113">moodyfin/shapes/pill_64.png</texturenofocus>
						<onclick>RunScript(script.moodyfin.helper,action=info,type=$INFO[Container(8000).ListItem.DBType],dbid=$INFO[Container(8000).ListItem.DBID])</onclick>
						<onleft>9201</onleft>
						<onright>Control.Move(8000,1)</onright>
						<onup>9100</onup>
						<ondown>9300</ondown>
					</control>
					<control type="image">
						<left>0</left><top>0</top><width>178</width><height>64</height>
						<texture border="32,0,32,0" colordiffuse="mf_text">moodyfin/shapes/pill_64.png</texture>
						<visible>Control.HasFocus(8000)</visible>
					</control>
					<control type="image">
						<left>0</left><top>0</top><width>178</width><height>64</height>
						<texture border="32,0,32,0" colordiffuse="33FFFFFF">moodyfin/shapes/pill_line_64.png</texture>
						<visible>!Control.HasFocus(9201) + !Control.HasFocus(8000)</visible>
					</control>
					<control type="image">
						<left>192</left><top>0</top><width>232</width><height>64</height>
						<texture border="32,0,32,0" colordiffuse="33FFFFFF">moodyfin/shapes/pill_line_64.png</texture>
						<visible>!Control.HasFocus(9202)</visible>
					</control>
					<control type="image">
						<left>28</left><top>16</top><width>32</width><height>32</height>
						<texture colordiffuse="FFF1F2F4">moodyfin/icons/play_arrow.png</texture>
						<visible>![Control.HasFocus(9201) | Control.HasFocus(8000)]</visible>
					</control>
					<control type="image">
						<left>28</left><top>16</top><width>32</width><height>32</height>
						<texture colordiffuse="FF000000">moodyfin/icons/play_arrow.png</texture>
						<visible>Control.HasFocus(9201) | Control.HasFocus(8000)</visible>
					</control>
					<control type="image">
						<left>222</left><top>17</top><width>30</width><height>30</height>
						<texture colordiffuse="FFF1F2F4">moodyfin/icons/info_outline.png</texture>
						<visible>![Control.HasFocus(9202)]</visible>
					</control>
					<control type="image">
						<left>222</left><top>17</top><width>30</width><height>30</height>
						<texture colordiffuse="FF000000">moodyfin/icons/info_outline.png</texture>
						<visible>Control.HasFocus(9202)</visible>
					</control>
					<control type="label">
						<left>72</left><top>0</top><width>120</width><height>64</height>
						<aligny>center</aligny>
						<font>mf_semibold25</font>
						<textcolor>$VAR[MFHeroIcon1]</textcolor>
						<label>Play</label>
					</control>
					<control type="label">
						<left>264</left><top>0</top><width>160</width><height>64</height>
						<aligny>center</aligny>
						<font>mf_semibold25</font>
						<textcolor>$VAR[MFHeroIcon2]</textcolor>
						<label>More info</label>
					</control>
					<!-- which title of how many -->
					<control type="label">
						<left>446</left><top>0</top><width>200</width><height>64</height>
						<aligny>center</aligny>
						<font>font10</font>
						<textcolor>99F1F2F4</textcolor>
						<label>$INFO[Container(8000).CurrentItem]$INFO[Container(8000).NumItems, / ,]</label>
						<visible>Integer.IsGreater(Container(8000).NumItems,1)</visible>
					</control>
				</control>
			</control>

			<!-- ======================================================== studios -->
			<control type="list" id="9300">
				<left>40</left><right>0</right><height>170</height>
				<orientation>horizontal</orientation>
				<scrolltime tween="cubic" easing="out">240</scrolltime>
				<onup>9200</onup>
				<ondown>4010</ondown>
				<onback>9201</onback>
				<itemlayout width="236" height="170">
					<control type="image">
						<left>28</left><top>35</top><width>180</width><height>100</height>
						<aspectratio>keep</aspectratio>
						<texture colordiffuse="EBFFFFFF">$INFO[ListItem.Icon]</texture>
					</control>
				</itemlayout>
				<focusedlayout width="236" height="170">
					<control type="image">
						<left>8</left><top>15</top><width>220</width><height>140</height>
						<texture border="12" colordiffuse="1FFFFFFF">moodyfin/shapes/rr12.png</texture>
						<visible>Control.HasFocus(9300)</visible>
					</control>
					<control type="image">
						<left>8</left><top>15</top><width>220</width><height>140</height>
						<texture border="14" colordiffuse="mf_accent">moodyfin/shapes/rr12_line.png</texture>
						<visible>Control.HasFocus(9300)</visible>
					</control>
					<control type="image">
						<left>28</left><top>35</top><width>180</width><height>100</height>
						<aspectratio>keep</aspectratio>
						<texture colordiffuse="FFFFFFFF">$INFO[ListItem.Icon]</texture>
						<animation effect="zoom" end="108" center="118,85" time="150" condition="Control.HasFocus(9300)">Conditional</animation>
					</control>
				</focusedlayout>
				<content>
					<include content="MFStudio"><param name="file" value="Paramount_Pictures" /><param name="names" value="Paramount Pictures" /></include>
					<include content="MFStudio"><param name="file" value="Prime_Video" /><param name="names" value="Prime Video|Amazon MGM Studios|Amazon Studios" /></include>
					<include content="MFStudio"><param name="file" value="Apple_TV" /><param name="names" value="Apple TV|Apple TV+" /></include>
					<include content="MFStudio"><param name="file" value="Disney_plus" /><param name="names" value="Disney+" /></include>
					<include content="MFStudio"><param name="file" value="Peacock" /><param name="names" value="Peacock" /></include>
					<include content="MFStudio"><param name="file" value="Columbia_Pictures" /><param name="names" value="Columbia Pictures" /></include>
					<include content="MFStudio"><param name="file" value="New_Line_Cinema" /><param name="names" value="New Line Cinema" /></include>
					<include content="MFStudio"><param name="file" value="Universal_Pictures" /><param name="names" value="Universal Pictures|Universal Television" /></include>
					<include content="MFStudio"><param name="file" value="Marvel_Studios" /><param name="names" value="Marvel Studios|Marvel Entertainment" /></include>
					<include content="MFStudio"><param name="file" value="Hulu" /><param name="names" value="Hulu" /></include>
					<include content="MFStudio"><param name="file" value="Paramount_plus_with_Showtime" /><param name="names" value="Paramount+|Paramount+ with Showtime" /></include>
					<include content="MFStudio"><param name="file" value="HBO" /><param name="names" value="HBO|HBO Films" /></include>
					<include content="MFStudio"><param name="file" value="HBO_Max" /><param name="names" value="HBO Max" /></include>
					<include content="MFStudio"><param name="file" value="AMC" /><param name="names" value="AMC|AMC Studios|AMC+" /></include>
					<include content="MFStudio"><param name="file" value="FX" /><param name="names" value="FX|FX Productions|FXX" /></include>
					<include content="MFStudio"><param name="file" value="Lucasfilm" /><param name="names" value="Lucasfilm Ltd.|Lucasfilm|Lucasfilm Animation" /></include>
					<include content="MFStudio"><param name="file" value="Warner_Bros" /><param name="names" value="Warner Bros. Pictures|Warner Bros. Animation|Warner Bros. Television" /></include>
					<include content="MFStudio"><param name="file" value="Walt_Disney_Pictures" /><param name="names" value="Walt Disney Pictures|Walt Disney Productions" /></include>
					<include content="MFStudio"><param name="file" value="DreamWorks_Animation" /><param name="names" value="DreamWorks Animation|DreamWorks Pictures" /></include>
					<include content="MFStudio"><param name="file" value="Showtime" /><param name="names" value="Showtime|Showtime Networks" /></include>
					<include content="MFStudio"><param name="file" value="Pixar" /><param name="names" value="Pixar|Pixar Animation Studios" /></include>
				</content>
			</control>

			<!-- ======================================================== Continue Watching & Next Up -->
			<control type="group" id="4010">
				<onup>9300</onup>
				<ondown>4020</ondown>
				<height>360</height>
				<visible>Integer.IsGreater(Container(401).NumItems,0) | Container(401).IsUpdating</visible>
				<include content="MFRowHeading"><param name="label" value="Continue Watching &amp; Next Up" /></include>
				<control type="list" id="401">
					<onup>9300</onup>
					<ondown>4020</ondown>
					<left>68</left><top>72</top><right>0</right><height>288</height>
					<orientation>horizontal</orientation>
					<scrolltime tween="cubic" easing="out">240</scrolltime>
					<onback>9201</onback>
					<itemlayout width="376" height="284"><include content="MFThumbCard"><param name="list" value="401" /></include></itemlayout>
					<focusedlayout width="376" height="284"><include content="MFThumbCard"><param name="list" value="401" /><param name="focused" value="true" /></include></focusedlayout>
					<content target="videos">plugin://script.moodyfin.helper/?row=continue&amp;reload=$INFO[Window(Home).Property(MoodyFin.Reload)]</content>
				</control>
			</control>

			<!-- ======================================================== Top 10
			     Numbers style (skin setting): one list, 402. Badge style (default): #1 as a wide card (4021), ranks 2-10
			     beside it (4022). Kodi gives every item of a list the same size, so #1 is a list of its own. -->
			<control type="group" id="4020">
				<onup>4010</onup>
				<ondown>4030</ondown>
				<height>400</height>
				<visible>Integer.IsGreater(Container(402).NumItems,0) | Integer.IsGreater(Container(4022).NumItems,0) | Container(402).IsUpdating | Container(4022).IsUpdating</visible>
				<include content="MFRowHeading"><param name="label" value="Top 10" /></include>
				<control type="list" id="402">
					<onclick>RunScript(script.moodyfin.helper,action=info,type=$INFO[ListItem.DBType],dbid=$INFO[ListItem.DBID])</onclick>
					<left>68</left><top>72</top><right>0</right><height>314</height>
					<onup>4010</onup>
					<ondown>4030</ondown>
					<onback>9201</onback>
					<orientation>horizontal</orientation>
					<scrolltime tween="cubic" easing="out">240</scrolltime>
					<visible>Skin.HasSetting(mf.top10numbers)</visible>
					<itemlayout width="330" height="310">
						<control type="image">
							<left>0</left><top>45</top><width>150</width><height>240</height>
							<aspectratio align="right" aligny="bottom">keep</aspectratio>
							<texture colordiffuse="66F1F2F4">moodyfin/numbers/$INFO[ListItem.Property(mf.rank)].png</texture>
						</control>
						<include content="MFPosterCard"><param name="list" value="402" /><param name="left" value="124" /><param name="text" value="false" /></include>
					</itemlayout>
					<focusedlayout width="330" height="310">
						<control type="image">
							<left>0</left><top>45</top><width>150</width><height>240</height>
							<aspectratio align="right" aligny="bottom">keep</aspectratio>
							<texture colordiffuse="CCF1F2F4">moodyfin/numbers/$INFO[ListItem.Property(mf.rank)].png</texture>
						</control>
						<include content="MFPosterCard"><param name="list" value="402" /><param name="left" value="124" /><param name="text" value="false" /><param name="focused" value="true" /></include>
					</focusedlayout>
					<content target="videos">plugin://script.moodyfin.helper/?row=top10&amp;reload=$INFO[Window(Home).Property(MoodyFin.Reload)]</content>
				</control>
				<control type="list" id="4021">
					<onclick>RunScript(script.moodyfin.helper,action=info,type=$INFO[ListItem.DBType],dbid=$INFO[ListItem.DBID])</onclick>
					<left>68</left><top>72</top><width>416</width><height>314</height>
					<onup>4010</onup>
					<ondown>4030</ondown>
					<onright>4022</onright>
					<onback>9201</onback>
					<orientation>horizontal</orientation>
					<visible>!Skin.HasSetting(mf.top10numbers)</visible>
					<itemlayout width="412" height="310"><include content="MFTop10Wide"><param name="list" value="4021" /></include></itemlayout>
					<focusedlayout width="412" height="310"><include content="MFTop10Wide"><param name="list" value="4021" /><param name="focused" value="true" /></include></focusedlayout>
					<content target="videos">plugin://script.moodyfin.helper/?row=top10&amp;part=first&amp;reload=$INFO[Window(Home).Property(MoodyFin.Reload)]</content>
				</control>
				<control type="list" id="4022">
					<onclick>RunScript(script.moodyfin.helper,action=info,type=$INFO[ListItem.DBType],dbid=$INFO[ListItem.DBID])</onclick>
					<left>480</left><top>72</top><right>0</right><height>314</height>
					<onup>4010</onup>
					<ondown>4030</ondown>
					<onleft>4021</onleft>
					<onback>9201</onback>
					<orientation>horizontal</orientation>
					<scrolltime tween="cubic" easing="out">240</scrolltime>
					<visible>!Skin.HasSetting(mf.top10numbers)</visible>
					<itemlayout width="206" height="310">
						<include content="MFPosterCard"><param name="list" value="4022" /><param name="text" value="false" /></include>
						<control type="group"><left>4</left><top>4</top><include content="MFRankBadge" /></control>
					</itemlayout>
					<focusedlayout width="206" height="310">
						<include content="MFPosterCard"><param name="list" value="4022" /><param name="text" value="false" /><param name="focused" value="true" /></include>
						<control type="group"><left>4</left><top>4</top><include content="MFRankBadge" /></control>
					</focusedlayout>
					<content target="videos">plugin://script.moodyfin.helper/?row=top10&amp;part=rest&amp;reload=$INFO[Window(Home).Property(MoodyFin.Reload)]</content>
				</control>
			</control>

			<include content="MFPosterRow"><param name="group" value="4030" /><param name="id" value="403" /><param name="up" value="4020" /><param name="down" value="4040" /><param name="label" value="Latest Releases" /><param name="row" value="latest" /></include>
			<include content="MFPosterRow"><param name="group" value="4040" /><param name="id" value="404" /><param name="up" value="4030" /><param name="down" value="4050" /><param name="label" value="Recently Added Movies" /><param name="row" value="recentmovies" /></include>
			<include content="MFPosterRow"><param name="group" value="4050" /><param name="id" value="405" /><param name="up" value="4040" /><param name="down" value="noop" /><param name="label" value="Recently Added Shows" /><param name="row" value="recentshows" /></include>
			<!-- room at the end so the last row can scroll up clear of the bottom -->
			<control type="image"><height>60</height><texture /></control>
		</control>

		<include content="MFHeader" />
	</controls>
</window>
