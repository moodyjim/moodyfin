<?xml version="1.0" encoding="UTF-8"?>
<!-- MoodyFin splash: the flame over a soft glow, then Kodi's start window (Home) after 2 s. -->
<window>
	<onload>AlarmClock(mfsplash,ReplaceWindow($INFO[System.StartupWindow]),00:02,silent)</onload>
	<controls>
		<control type="image">
			<left>0</left><top>0</top><width>100%</width><height>100%</height>
			<texture colordiffuse="FF000000">colors/white.png</texture>
		</control>
		<control type="image">
			<centerleft>50%</centerleft><centertop>44%</centertop><width>640</width><height>640</height>
			<texture colordiffuse="99FFFFFF">moodyfin/logo_glow.png</texture>
			<animation effect="fade" start="0" end="100" time="900" tween="sine">WindowOpen</animation>
			<animation effect="zoom" start="80" end="100" center="auto" time="1400" tween="cubic" easing="out">WindowOpen</animation>
		</control>
		<control type="image">
			<centerleft>50%</centerleft><centertop>44%</centertop><width>200</width><height>200</height>
			<aspectratio>keep</aspectratio>
			<texture>moodyfin/logo.png</texture>
			<animation effect="fade" start="0" end="100" time="600" tween="sine">WindowOpen</animation>
			<animation effect="zoom" start="90" end="100" center="auto" time="900" tween="cubic" easing="out">WindowOpen</animation>
		</control>
		<control type="label">
			<left>0</left><top>640</top><width>100%</width><height>90</height>
			<align>center</align>
			<font>mf_heading72</font>
			<textcolor>mf_text</textcolor>
			<label>MoodyFin</label>
			<animation effect="fade" start="0" end="100" delay="400" time="600">WindowOpen</animation>
		</control>
		<control type="label">
			<left>0</left><top>724</top><width>100%</width><height>40</height>
			<align>center</align>
			<font>mf_small20</font>
			<textcolor>mf_muted</textcolor>
			<label>$INFO[Window(Home).Property(MoodyFin.Server)]</label>
			<animation effect="fade" start="0" end="100" delay="700" time="600">WindowOpen</animation>
		</control>
	</controls>
</window>
