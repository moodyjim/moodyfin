<?xml version="1.0" encoding="UTF-8"?>
<!-- MoodyFin details page (the Jellyfin theme's title page), Kodi's video info dialog: movies, shows, episodes (and, plainly,
     seasons / sets). ListItem.* here is always the dialog's item; lists use Container(id).
     Kodi's own ids: 8 Play (resume prompt; Browse for shows/seasons/sets), 11 Trailer, 50 Cast (Kodi fills it).
     MoodyFin: 22 play next episode (shows), 21 watched toggle (helper), rows 501 Next Up, 502 Seasons,
     504 Collection, 505/506 More Like This (plugin.video.moodysimilar for movies, else the helper).
     Page scrolling: stacked conditional slides on 9000, like Home. -->
<window>
	<defaultcontrol always="true">5000</defaultcontrol>
	<onload>ClearProperty(mf.watched,movieinformation)</onload>
	<onload condition="String.IsEqual(ListItem.DBType,tvshow)">SetFocus(22)</onload>
	<onload condition="!String.IsEqual(ListItem.DBType,tvshow)">SetFocus(8)</onload>
	<controls>
		<include>MFAmbient</include>

		<control type="grouplist" id="9000">
			<left>0</left><top>0</top><width>100%</width><height>4000</height>
			<orientation>vertical</orientation>
			<itemgap>0</itemgap>
			<animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
			<animation effect="slide" end="0,-930" time="320" tween="cubic" easing="out" condition="ControlGroup(5010).HasFocus | ControlGroup(5020).HasFocus | ControlGroup(5030).HasFocus | ControlGroup(5040).HasFocus | ControlGroup(5050).HasFocus">Conditional</animation>
			<animation effect="slide" end="0,-360" time="320" tween="cubic" easing="out" condition="Control.IsVisible(5010) + [ControlGroup(5020).HasFocus | ControlGroup(5030).HasFocus | ControlGroup(5040).HasFocus | ControlGroup(5050).HasFocus]">Conditional</animation>
			<animation effect="slide" end="0,-460" time="320" tween="cubic" easing="out" condition="Control.IsVisible(5020) + [ControlGroup(5030).HasFocus | ControlGroup(5040).HasFocus | ControlGroup(5050).HasFocus]">Conditional</animation>
			<animation effect="slide" end="0,-400" time="320" tween="cubic" easing="out" condition="Control.IsVisible(5030) + [ControlGroup(5040).HasFocus | ControlGroup(5050).HasFocus]">Conditional</animation>
			<animation effect="slide" end="0,-460" time="320" tween="cubic" easing="out" condition="Control.IsVisible(5040) + ControlGroup(5050).HasFocus">Conditional</animation>

			<!-- ======================================================== top: backdrop, logo, poster, info band, text -->
			<control type="group" id="100">
				<height>1000</height>
				<control type="image">
					<left>0</left><top>0</top><width>100%</width><height>1100</height>
					<aspectratio>stretch</aspectratio>
					<fadetime>400</fadetime>
					<texture background="true" diffuse="moodyfin/masks/details.png" colordiffuse="59FFFFFF">$INFO[ListItem.Art(fanart)]</texture>
				</control>
				<control type="image">
					<left>0</left><top>0</top><width>100%</width><height>420</height>
					<texture colordiffuse="80000000">moodyfin/shapes/grad_up.png</texture>
				</control>
				<!-- title logo, or the title in Bebas, centred over the text column -->
				<control type="image">
					<left>520</left><top>40</top><right>72</right><height>190</height>
					<aspectratio align="center" aligny="center">keep</aspectratio>
					<fadetime>300</fadetime>
					<texture background="true">$VAR[MFDetailsLogo]</texture>
				</control>
				<control type="label">
					<left>520</left><top>40</top><right>72</right><height>190</height>
					<align>center</align><aligny>center</aligny>
					<font>mf_heading72</font>
					<textcolor>mf_text</textcolor>
					<label>$INFO[ListItem.Title]</label>
					<visible>String.IsEmpty(ListItem.Art(clearlogo)) + String.IsEmpty(ListItem.Art(tvshow.clearlogo))</visible>
				</control>
				<!-- info band -->
				<control type="image">
					<left>0</left><top>270</top><width>100%</width><height>124</height>
					<texture colordiffuse="E6141518">colors/white.png</texture>
				</control>
				<!-- poster -->
				<control type="group">
					<left>72</left><top>232</top>
					<control type="image">
						<width>400</width><height>600</height>
						<texture border="12" colordiffuse="mf_surface">moodyfin/shapes/rr12.png</texture>
					</control>
					<control type="image">
						<width>400</width><height>600</height>
						<aspectratio>scale</aspectratio>
						<texture background="true" diffuse="moodyfin/masks/poster_large.png">$VAR[MFDetailsPoster]</texture>
					</control>
				</control>
				<!-- title and meta -->
				<control type="label">
					<left>520</left><top>284</top><right>480</right><height>48</height>
					<aligny>center</aligny>
					<font>mf_semibold30</font>
					<textcolor>mf_text</textcolor>
					<label>$VAR[MFDetailsTitle]</label>
				</control>
				<control type="grouplist">
					<left>520</left><top>336</top><right>480</right><height>36</height>
					<orientation>horizontal</orientation>
					<itemgap>22</itemgap>
					<usecontrolwidth>true</usecontrolwidth>
					<control type="label">
						<width>auto</width><height>36</height>
						<aligny>center</aligny>
						<font>mf_small20</font>
						<textcolor>D9F1F2F4</textcolor>
						<label>$VAR[MFDetailsFirst]</label>
					</control>
					<control type="label">
						<width>auto</width><height>36</height>
						<aligny>center</aligny>
						<font>mf_small20</font>
						<textcolor>D9F1F2F4</textcolor>
						<label>$VAR[MFDuration]</label>
						<visible>!$EXP[mf_is_show]</visible>
					</control>
					<control type="button">
						<width>auto</width><height>30</height>
						<top>3</top>
						<label>$INFO[ListItem.Mpaa]</label>
						<font>font_flag</font>
						<textoffsetx>10</textoffsetx>
						<aligny>center</aligny>
						<disabledcolor>D9F1F2F4</disabledcolor>
						<texturenofocus border="5" colordiffuse="99F1F2F4">moodyfin/shapes/rr6_line.png</texturenofocus>
						<texturefocus border="5" colordiffuse="99F1F2F4">moodyfin/shapes/rr6_line.png</texturefocus>
						<enable>false</enable>
						<visible>!String.IsEmpty(ListItem.Mpaa)</visible>
					</control>
					<control type="label">
						<width>auto</width><height>36</height>
						<aligny>center</aligny>
						<font>mf_small20</font>
						<textcolor>D9F1F2F4</textcolor>
						<label>$INFO[ListItem.Rating,[COLOR mf_star]★[/COLOR] ,]</label>
					</control>
					<control type="label">
						<width>auto</width><height>36</height>
						<aligny>center</aligny>
						<font>mf_small20</font>
						<textcolor>D9F1F2F4</textcolor>
						<label>$INFO[ListItem.EndTimeResume,Ends at ,]</label>
						<visible>!$EXP[mf_is_show] + !String.IsEqual(ListItem.DBType,set) + !String.IsEqual(ListItem.DBType,season)</visible>
					</control>
				</control>
				<!-- action buttons -->
				<control type="grouplist" id="5000">
					<right>72</right><top>300</top><width>400</width><height>64</height>
					<orientation>horizontal</orientation>
					<align>right</align>
					<itemgap>14</itemgap>
					<ondown>5010</ondown>
					<control type="button" id="22">
						<width>64</width><height>64</height>
						<label />
						<texturenofocus>moodyfin/buttons/play_arrow.png</texturenofocus>
						<texturefocus>moodyfin/buttons/play_arrow_focus.png</texturefocus>
						<onclick>RunScript(script.moodyfin.helper,action=playnext,tvshowid=$INFO[ListItem.DBID])</onclick>
						<visible>$EXP[mf_is_show]</visible>
					</control>
					<control type="button" id="8">
						<width>64</width><height>64</height>
						<label />
						<texturenofocus>moodyfin/buttons/play_arrow.png</texturenofocus>
						<texturefocus>moodyfin/buttons/play_arrow_focus.png</texturefocus>
						<visible>!$EXP[mf_is_show]</visible>
					</control>
					<control type="button" id="11">
						<width>64</width><height>64</height>
						<label />
						<texturenofocus>moodyfin/buttons/movie.png</texturenofocus>
						<texturefocus>moodyfin/buttons/movie_focus.png</texturefocus>
						<visible>!String.IsEmpty(ListItem.Trailer) + [!String.Contains(ListItem.Trailer,plugin.video.youtube) | System.AddonIsEnabled(plugin.video.youtube)]</visible>
					</control>
					<control type="togglebutton" id="21">
						<width>64</width><height>64</height>
						<label />
						<texturenofocus>moodyfin/buttons/check.png</texturenofocus>
						<texturefocus>moodyfin/buttons/check_focus.png</texturefocus>
						<alttexturenofocus>moodyfin/buttons/check_on.png</alttexturenofocus>
						<alttexturefocus>moodyfin/buttons/check_focus.png</alttexturefocus>
						<usealttexture>$EXP[mf_watched]</usealttexture>
						<onclick>RunScript(script.moodyfin.helper,action=watched,type=$INFO[ListItem.DBType],dbid=$INFO[ListItem.DBID])</onclick>
						<visible>[$EXP[mf_is_movie] | $EXP[mf_is_show] | $EXP[mf_is_episode]] + Integer.IsGreater(ListItem.DBID,0)</visible>
					</control>
				</control>
				<!-- streams, plot, tags, people -->
				<control type="grouplist">
					<left>520</left><top>424</top><right>72</right><height>560</height>
					<orientation>vertical</orientation>
					<itemgap>0</itemgap>
					<include content="MFDetailsLine">
						<param name="label" value="Video" /><param name="value" value="$VAR[MFVideoLine]" />
						<param name="cond" value="!String.IsEmpty(ListItem.VideoCodec)" />
					</include>
					<include content="MFDetailsLine">
						<param name="label" value="Audio" /><param name="value" value="$VAR[MFAudioLine]" />
						<param name="cond" value="!String.IsEmpty(ListItem.AudioCodec)" />
					</include>
					<include content="MFDetailsLine">
						<param name="label" value="Subtitles" /><param name="value" value="$VAR[MFSubLang]" />
						<param name="cond" value="!String.IsEmpty(ListItem.SubtitleLanguage)" />
					</include>
					<control type="image"><height>16</height><texture /></control>
					<control type="textbox">
						<height>126</height>
						<font>font12</font>
						<textcolor>E6F1F2F4</textcolor>
						<label>$INFO[ListItem.Plot]</label>
					</control>
					<control type="image"><height>12</height><texture /></control>
					<control type="label">
						<height>30</height>
						<font>mf_small20</font>
						<textcolor>mf_muted</textcolor>
						<label>$INFO[ListItem.Tag,Tags: ,]</label>
						<visible>!String.IsEmpty(ListItem.Tag)</visible>
					</control>
					<control type="image"><height>14</height><texture /></control>
					<include content="MFDetailsLine">
						<param name="label" value="Director" /><param name="value" value="$INFO[ListItem.Director]" />
						<param name="cond" value="!String.IsEmpty(ListItem.Director)" />
					</include>
					<include content="MFDetailsLine">
						<param name="label" value="Writers" /><param name="value" value="$INFO[ListItem.Writer]" />
						<param name="cond" value="!String.IsEmpty(ListItem.Writer)" />
					</include>
					<include content="MFDetailsLine">
						<param name="label" value="Studios" /><param name="value" value="$INFO[ListItem.Studio]" />
						<param name="cond" value="!String.IsEmpty(ListItem.Studio)" />
					</include>
					<include content="MFDetailsLine">
						<param name="label" value="Genres" /><param name="value" value="$INFO[ListItem.Genre]" />
						<param name="cond" value="!String.IsEmpty(ListItem.Genre)" />
					</include>
				</control>
			</control>

			<!-- ======================================================== Next Up (shows) -->
			<control type="group" id="5010">
				<onup>5000</onup>
				<ondown>5020</ondown>
				<height>360</height>
				<visible>$EXP[mf_is_show] + [Integer.IsGreater(Container(501).NumItems,0) | Container(501).IsUpdating]</visible>
				<include content="MFRowHeading"><param name="label" value="Next Up" /></include>
				<control type="list" id="501">
					<left>68</left><top>72</top><right>0</right><height>288</height>
					<onup>5000</onup>
					<ondown>5020</ondown>
					<orientation>horizontal</orientation>
					<itemlayout width="376" height="284"><include content="MFThumbCard"><param name="list" value="501" /></include></itemlayout>
					<focusedlayout width="376" height="284"><include content="MFThumbCard"><param name="list" value="501" /><param name="focused" value="true" /></include></focusedlayout>
					<onclick>RunScript(script.moodyfin.helper,action=play,type=episode,dbid=$INFO[ListItem.DBID])</onclick>
					<content target="videos">plugin://script.moodyfin.helper/?row=nextup&amp;tvshowid=$INFO[ListItem.DBID]</content>
				</control>
			</control>

			<!-- ======================================================== Seasons (shows) -->
			<control type="group" id="5020">
				<onup>5010</onup>
				<ondown>5030</ondown>
				<height>460</height>
				<visible>$EXP[mf_is_show] + [Integer.IsGreater(Container(502).NumItems,0) | Container(502).IsUpdating]</visible>
				<include content="MFRowHeading"><param name="label" value="Seasons" /></include>
				<control type="list" id="502">
					<left>68</left><top>72</top><right>0</right><height>374</height>
					<onup>5010</onup>
					<ondown>5030</ondown>
					<orientation>horizontal</orientation>
					<scrolltime tween="cubic" easing="out">240</scrolltime>
					<itemlayout width="206" height="370"><include content="MFPosterCard"><param name="list" value="502" /></include></itemlayout>
					<focusedlayout width="206" height="370"><include content="MFPosterCard"><param name="list" value="502" /><param name="focused" value="true" /></include></focusedlayout>
					<onclick>Dialog.Close(movieinformation,true)</onclick>
					<onclick>ActivateWindow(Videos,$INFO[ListItem.FolderPath],return)</onclick>
					<content target="videos">plugin://script.moodyfin.helper/?row=seasons&amp;tvshowid=$INFO[ListItem.DBID]</content>
				</control>
			</control>

			<!-- ======================================================== Cast (Kodi fills list 50) -->
			<control type="group" id="5030">
				<onup>5020</onup>
				<ondown>5040</ondown>
				<height>400</height>
				<visible>Integer.IsGreater(Container(50).NumItems,0)</visible>
				<include content="MFRowHeading"><param name="label" value="Cast &amp; Crew" /></include>
				<control type="list" id="50">
					<left>68</left><top>72</top><right>0</right><height>324</height>
					<onup>5020</onup>
					<ondown>5040</ondown>
					<orientation>horizontal</orientation>
					<scrolltime tween="cubic" easing="out">240</scrolltime>
					<itemlayout width="176" height="320"><include content="MFCastCard"><param name="list" value="50" /></include></itemlayout>
					<focusedlayout width="176" height="320"><include content="MFCastCard"><param name="list" value="50" /><param name="focused" value="true" /></include></focusedlayout>
				</control>
			</control>

			<!-- ======================================================== Collection (movies in a set) -->
			<control type="group" id="5040">
				<onup>5030</onup>
				<ondown>5050</ondown>
				<height>460</height>
				<visible>$EXP[mf_is_movie] + Integer.IsGreater(ListItem.SetId,0) + [Integer.IsGreater(Container(504).NumItems,0) | Container(504).IsUpdating]</visible>
				<include content="MFRowHeading"><param name="label" value="Collection" /></include>
				<control type="list" id="504">
					<left>68</left><top>72</top><right>0</right><height>374</height>
					<onup>5030</onup>
					<ondown>5050</ondown>
					<orientation>horizontal</orientation>
					<itemlayout width="206" height="370"><include content="MFPosterCard"><param name="list" value="504" /></include></itemlayout>
					<focusedlayout width="206" height="370"><include content="MFPosterCard"><param name="list" value="504" /><param name="focused" value="true" /></include></focusedlayout>
					<onclick>Dialog.Close(movieinformation,true)</onclick>
					<onclick>ActivateWindow(Videos,$INFO[ListItem.FolderPath],return)</onclick>
					<content target="videos">plugin://script.moodyfin.helper/?row=collection&amp;setid=$INFO[ListItem.SetId]</content>
				</control>
			</control>

			<!-- ======================================================== More Like This -->
			<control type="group" id="5050">
				<onup>5040</onup>
				<height>460</height>
				<visible>Integer.IsGreater(Container(505).NumItems,0) | Integer.IsGreater(Container(506).NumItems,0) | Container(505).IsUpdating | Container(506).IsUpdating</visible>
				<include content="MFRowHeading"><param name="label" value="More Like This" /></include>
				<control type="list" id="505">
					<left>68</left><top>72</top><right>0</right><height>374</height>
					<onup>5040</onup>
					<orientation>horizontal</orientation>
					<scrolltime tween="cubic" easing="out">240</scrolltime>
					<visible>$EXP[mf_is_movie] + System.AddonIsEnabled(plugin.video.moodysimilar)</visible>
					<itemlayout width="206" height="370"><include content="MFPosterCard"><param name="list" value="505" /></include></itemlayout>
					<focusedlayout width="206" height="370"><include content="MFPosterCard"><param name="list" value="505" /><param name="focused" value="true" /></include></focusedlayout>
					<onclick>RunScript(script.moodyfin.helper,action=info,type=movie,dbid=$INFO[ListItem.DBID])</onclick>
					<content target="videos">plugin://plugin.video.moodysimilar/?dbid=$INFO[ListItem.DBID]&amp;limit=16</content>
				</control>
				<control type="list" id="506">
					<left>68</left><top>72</top><right>0</right><height>374</height>
					<onup>5040</onup>
					<orientation>horizontal</orientation>
					<scrolltime tween="cubic" easing="out">240</scrolltime>
					<visible>[$EXP[mf_is_show] | [$EXP[mf_is_movie] + !System.AddonIsEnabled(plugin.video.moodysimilar)]]</visible>
					<itemlayout width="206" height="370"><include content="MFPosterCard"><param name="list" value="506" /></include></itemlayout>
					<focusedlayout width="206" height="370"><include content="MFPosterCard"><param name="list" value="506" /><param name="focused" value="true" /></include></focusedlayout>
					<onclick>RunScript(script.moodyfin.helper,action=info,type=$INFO[ListItem.DBType],dbid=$INFO[ListItem.DBID])</onclick>
					<content target="videos">plugin://script.moodyfin.helper/?row=similar&amp;type=$INFO[ListItem.DBType]&amp;dbid=$INFO[ListItem.DBID]</content>
				</control>
			</control>
			<control type="image"><height>80</height><texture /></control>
		</control>
	</controls>
</window>
