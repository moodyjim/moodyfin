<?xml version="1.0" encoding="UTF-8"?>
<!-- MoodyFin library pages (the Jellyfin theme's Movies page): Kodi's Videos window.
     Header (current section marked), title + count, toolbar, and one of three views, picked by content:
       520 poster grid   movies, shows, seasons, collections
       521 episode list  episodes
       522 plain list    everything else (library nodes, genres, years, folders, add-ons)
     Kodi's own ids: 3 sort method, 4 sort order, 10 watched filter, 199/19 filter. SetFocus(520) = "the current
     view" (Kodi moves focus to whichever view is showing). -->
<window>
	<defaultcontrol always="true">520</defaultcontrol>
	<backgroundcolor>background</backgroundcolor>
	<views>520,521,522</views>
	<menucontrol>7000</menucontrol>
	<controls>
		<include>MFAmbient</include>

		<!-- ======================================================== title, count, sort, toolbar -->
		<control type="group">
			<animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
			<control type="grouplist">
				<left>mf_gutter</left><top>112</top><right>700</right><height>72</height>
				<orientation>horizontal</orientation>
				<itemgap>18</itemgap>
				<usecontrolwidth>true</usecontrolwidth>
				<control type="label">
					<width>auto</width><height>72</height>
					<aligny>center</aligny>
					<font>mf_heading72</font>
					<textcolor>mf_text</textcolor>
					<label>$VAR[MFLibraryTitle]</label>
				</control>
				<control type="button">
					<top>21</top><width>auto</width><height>30</height>
					<label>$INFO[Container.CurrentItem,, of ]$INFO[Container.NumItems]</label>
					<font>font_flag</font>
					<textoffsetx>14</textoffsetx>
					<aligny>center</aligny>
					<disabledcolor>D9F1F2F4</disabledcolor>
					<texturenofocus border="15,0,15,0" colordiffuse="29F1F2F4">moodyfin/shapes/pill_40.png</texturenofocus>
					<texturefocus border="15,0,15,0" colordiffuse="29F1F2F4">moodyfin/shapes/pill_40.png</texturefocus>
					<enable>false</enable>
					<visible>Integer.IsGreater(Container.NumItems,0)</visible>
				</control>
			</control>
			<control type="label">
				<right>420</right><top>112</top><width>600</width><height>72</height>
				<align>right</align><aligny>center</aligny>
				<font>mf_small20</font>
				<textcolor>mf_muted</textcolor>
				<label>$INFO[Container.SortMethod]$INFO[Container.SortOrder,  ·  ,]$VAR[MFWatchedFilterLabel]</label>
				<visible>Control.IsEnabled(3)</visible>
			</control>
			<control type="grouplist" id="7000">
				<right>72</right><top>116</top><width>340</width><height>64</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>12</itemgap>
				<onup>9100</onup>
				<ondown>520</ondown>
				<control type="button" id="3">
					<width>64</width><height>64</height>
					<label />
					<textcolor>00000000</textcolor>
					<focusedcolor>00000000</focusedcolor>
					<disabledcolor>00000000</disabledcolor>
					<texturenofocus>moodyfin/buttons/sort_by_alpha.png</texturenofocus>
					<texturefocus>moodyfin/buttons/sort_by_alpha_focus.png</texturefocus>
				</control>
				<control type="button" id="4">
					<width>64</width><height>64</height>
					<label />
					<textcolor>00000000</textcolor>
					<focusedcolor>00000000</focusedcolor>
					<disabledcolor>00000000</disabledcolor>
					<texturenofocus>moodyfin/buttons/swap_vert.png</texturenofocus>
					<texturefocus>moodyfin/buttons/swap_vert_focus.png</texturefocus>
				</control>
				<control type="button" id="10">
					<width>64</width><height>64</height>
					<label />
					<textcolor>00000000</textcolor>
					<focusedcolor>00000000</focusedcolor>
					<disabledcolor>00000000</disabledcolor>
					<texturenofocus>moodyfin/buttons/visibility.png</texturenofocus>
					<texturefocus>moodyfin/buttons/visibility_focus.png</texturefocus>
					<visible>Container.Content(movies) | Container.Content(sets) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(episodes)</visible>
				</control>
				<control type="button" id="199">
					<width>64</width><height>64</height>
					<label />
					<textcolor>00000000</textcolor>
					<focusedcolor>00000000</focusedcolor>
					<disabledcolor>00000000</disabledcolor>
					<texturenofocus>moodyfin/buttons/filter_alt.png</texturenofocus>
					<texturefocus>moodyfin/buttons/filter_alt_focus.png</texturefocus>
					<onclick>Filter</onclick>
					<visible>Container.CanFilterAdvanced</visible>
				</control>
				<control type="button" id="19">
					<width>64</width><height>64</height>
					<label />
					<textcolor>00000000</textcolor>
					<focusedcolor>00000000</focusedcolor>
					<disabledcolor>00000000</disabledcolor>
					<texturenofocus>moodyfin/buttons/filter_alt.png</texturenofocus>
					<texturefocus>moodyfin/buttons/filter_alt_focus.png</texturefocus>
					<visible>Container.CanFilter + !Container.CanFilterAdvanced</visible>
				</control>
			</control>
		</control>

		<!-- ======================================================== views -->
		<control type="group">
			<animation effect="fade" start="0" end="100" time="250">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
			<animation effect="fade" start="100" end="0" time="200" condition="$EXP[infodialog_active]">Conditional</animation>

			<!-- 520: poster grid -->
			<control type="panel" id="520">
				<left>mf_gutter</left><top>206</top><right>40</right><bottom>0</bottom>
				<onup>7000</onup>
				<onleft>7000</onleft>
				<orientation>vertical</orientation>
				<scrolltime tween="cubic" easing="out">260</scrolltime>
				<preloaditems>2</preloaditems>
				<viewtype label="Posters">icon</viewtype>
				<visible>Container.Content(movies) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(sets)</visible>
				<itemlayout width="206" height="390"><include content="MFPosterCard"><param name="list" value="520" /></include></itemlayout>
				<focusedlayout width="206" height="390"><include content="MFPosterCard"><param name="list" value="520" /><param name="focused" value="true" /></include></focusedlayout>
			</control>

			<!-- 521: episode list -->
			<control type="list" id="521">
				<left>mf_gutter</left><top>206</top><right>mf_gutter</right><bottom>0</bottom>
				<onup>7000</onup>
				<onleft>7000</onleft>
				<orientation>vertical</orientation>
				<scrolltime tween="cubic" easing="out">260</scrolltime>
				<viewtype label="Episodes">list</viewtype>
				<visible>Container.Content(episodes)</visible>
				<itemlayout height="236"><include content="MFEpisodeRow"><param name="list" value="521" /></include></itemlayout>
				<focusedlayout height="236"><include content="MFEpisodeRow"><param name="list" value="521" /><param name="focused" value="true" /></include></focusedlayout>
			</control>

			<!-- 522: plain list -->
			<control type="list" id="522">
				<left>mf_gutter</left><top>206</top><width>1100</width><bottom>0</bottom>
				<onup>7000</onup>
				<onleft>7000</onleft>
				<orientation>vertical</orientation>
				<scrolltime tween="cubic" easing="out">200</scrolltime>
				<viewtype label="List">list</viewtype>
				<visible>!Container.Content(movies) + !Container.Content(tvshows) + !Container.Content(seasons) + !Container.Content(sets) + !Container.Content(episodes)</visible>
				<itemlayout height="72"><include content="MFListRow"><param name="list" value="522" /></include></itemlayout>
				<focusedlayout height="72"><include content="MFListRow"><param name="list" value="522" /><param name="focused" value="true" /></include></focusedlayout>
			</control>
			<!-- plain list: the focused item's picture on the right -->
			<control type="image">
				<left>1260</left><top>220</top><right>mf_gutter</right><height>600</height>
				<aspectratio aligny="top">keep</aspectratio>
				<fadetime>200</fadetime>
				<texture background="true">$INFO[Container(522).ListItem.Art(poster)]</texture>
				<visible>Control.IsVisible(522) + !String.IsEmpty(Container(522).ListItem.Art(poster))</visible>
			</control>
		</control>

		<include content="MFHeader"><param name="down" value="520" /><param name="stats" value="false" /></include>
	</controls>
</window>
