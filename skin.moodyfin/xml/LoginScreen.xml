<?xml version="1.0" encoding="UTF-8"?>
<!-- MoodyFin profile picker (the Jellyfin theme's sign-in page). Shown by Kodi when the login screen is turned on
     (Settings > Profiles > General). Kodi's ids: 52 profiles list, 20 power. -->
<window>
	<defaultcontrol always="true">52</defaultcontrol>
	<controls>
		<control type="image">
			<left>0</left><top>0</top><width>100%</width><height>100%</height>
			<texture colordiffuse="FF000000">colors/white.png</texture>
		</control>
		<control type="image">
			<left>0</left><top>0</top><width>100%</width><height>100%</height>
			<aspectratio>scale</aspectratio>
			<texture>special://skin/resources/fanart.jpg</texture>
			<animation effect="fade" start="0" end="100" time="800">WindowOpen</animation>
		</control>
		<control type="image">
			<left>mf_gutter</left><top>36</top><width>56</width><height>56</height>
			<aspectratio>keep</aspectratio>
			<texture>moodyfin/logo.png</texture>
		</control>

		<!-- welcome -->
		<control type="group">
			<left>130</left><top>300</top>
			<animation effect="slide" start="-60,0" end="0,0" time="500" tween="cubic" easing="out">WindowOpen</animation>
			<animation effect="fade" start="0" end="100" time="500">WindowOpen</animation>
			<control type="label">
				<width>1100</width><height>40</height>
				<font>mf_heading36</font>
				<textcolor>mf_accent</textcolor>
				<label>$INFO[Window(Home).Property(MoodyFin.Stats)]</label>
			</control>
			<control type="label">
				<top>44</top><width>1300</width><height>150</height>
				<font>mf_heading120</font>
				<textcolor>mf_text</textcolor>
				<label>Welcome to</label>
			</control>
			<control type="label">
				<top>176</top><width>1300</width><height>150</height>
				<font>mf_heading120</font>
				<textcolor>mf_accent</textcolor>
				<label>$VAR[MFServerName]</label>
			</control>
			<control type="group">
				<top>370</top>
				<control type="image">
					<width>4</width><height>100</height>
					<texture colordiffuse="mf_accent">colors/white.png</texture>
				</control>
				<control type="textbox">
					<left>26</left><width>820</width><height>100</height>
					<font>font12</font>
					<textcolor>CCF1F2F4</textcolor>
					<label>Choose who is watching. Your Continue Watching, favourites and watched marks follow your profile.</label>
				</control>
			</control>
		</control>

		<!-- sign in -->
		<control type="group">
			<right>0</right><top>0</top><width>560</width><height>100%</height>
			<animation effect="slide" start="560,0" end="0,0" time="450" tween="cubic" easing="out">WindowOpen</animation>
			<control type="image">
				<width>560</width><height>100%</height>
				<texture colordiffuse="F20B0C0E">colors/white.png</texture>
			</control>
			<control type="image">
				<width>1</width><height>100%</height>
				<texture colordiffuse="mf_border">colors/white.png</texture>
			</control>
			<control type="label">
				<left>60</left><top>300</top><width>440</width><height>40</height>
				<font>mf_heading36</font>
				<textcolor>mf_accent</textcolor>
				<label>$VAR[MFServerName]</label>
			</control>
			<control type="label">
				<left>60</left><top>344</top><width>440</width><height>90</height>
				<font>mf_heading72</font>
				<textcolor>mf_text</textcolor>
				<label>Sign in</label>
			</control>
			<control type="label">
				<left>60</left><top>430</top><width>440</width><height>32</height>
				<font>mf_small20</font>
				<textcolor>mf_muted</textcolor>
				<label>Welcome back. Pick up where you left off.</label>
			</control>
			<control type="list" id="52">
				<left>60</left><top>490</top><width>440</width><height>380</height>
				<orientation>vertical</orientation>
				<onup>52</onup>
				<ondown>20</ondown>
				<itemlayout height="76" width="440">
					<control type="image">
						<left>0</left><top>6</top><width>440</width><height>64</height>
						<texture border="12" colordiffuse="FF1A1C20">moodyfin/shapes/rr12.png</texture>
					</control>
					<control type="image">
						<left>12</left><top>14</top><width>48</width><height>48</height>
						<aspectratio>scale</aspectratio>
						<texture diffuse="moodyfin/shapes/circle.png" fallback="DefaultUser.png">$INFO[ListItem.Icon]</texture>
					</control>
					<control type="label">
						<left>76</left><top>6</top><width>340</width><height>64</height>
						<aligny>center</aligny>
						<font>mf_semibold25</font>
						<textcolor>mf_text</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</itemlayout>
				<focusedlayout height="76" width="440">
					<control type="image">
						<left>0</left><top>6</top><width>440</width><height>64</height>
						<texture border="12" colordiffuse="mf_accent">moodyfin/shapes/rr12.png</texture>
						<visible>Control.HasFocus(52)</visible>
					</control>
					<control type="image">
						<left>0</left><top>6</top><width>440</width><height>64</height>
						<texture border="12" colordiffuse="FF1A1C20">moodyfin/shapes/rr12.png</texture>
						<visible>!Control.HasFocus(52)</visible>
					</control>
					<control type="image">
						<left>12</left><top>14</top><width>48</width><height>48</height>
						<aspectratio>scale</aspectratio>
						<texture diffuse="moodyfin/shapes/circle.png" fallback="DefaultUser.png">$INFO[ListItem.Icon]</texture>
					</control>
					<control type="label">
						<left>76</left><top>6</top><width>340</width><height>64</height>
						<aligny>center</aligny>
						<font>mf_heading36</font>
						<textcolor>$VAR[MFLoginText]</textcolor>
						<label>$INFO[ListItem.Label]</label>
					</control>
				</focusedlayout>
			</control>
			<control type="button" id="20">
				<left>60</left><bottom>80</bottom><width>440</width><height>64</height>
				<label>Power</label>
				<font>mf_heading36</font>
				<align>center</align><aligny>center</aligny>
				<textcolor>mf_text</textcolor>
				<focusedcolor>FF000000</focusedcolor>
				<texturefocus border="12" colordiffuse="mf_text">moodyfin/shapes/rr12.png</texturefocus>
				<texturenofocus border="14" colordiffuse="40FFFFFF">moodyfin/shapes/rr12_line.png</texturenofocus>
				<onclick>ActivateWindow(ShutdownMenu)</onclick>
				<onup>52</onup>
			</control>
		</control>
	</controls>
</window>
