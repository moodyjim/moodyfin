<?xml version="1.0" encoding="UTF-8"?>
<!-- MoodyFin seek bar and pause screen. Kodi keeps this dialog open during playback; the skin decides when it shows.
     Seeking or just paused: the time / progress part of the player panel (the full panel is VideoOSD).
     Paused for 3 s: the pause screen (Kodi doesn't draw VideoFullScreen's own controls, so it lives here). -->
<window>
	<visible>Window.IsActive(fullscreenvideo)</visible>
	<visible>!Window.IsActive(videoosd) + !Window.IsActive(sliderdialog) + !Window.IsActive(1110)</visible>
	<visible>Player.Seeking | Player.HasPerformedSeek(3) | Player.Forwarding | Player.Rewinding | Player.ShowTime | Player.ShowInfo | Window.IsActive(fullscreeninfo) | [Player.Paused + !Player.Caching] | !String.IsEmpty(Player.SeekNumeric)</visible>
	<depth>DepthOSD</depth>
	<zorder>0</zorder>
	<animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
	<controls>
		<control type="group">
		<visible>!$EXP[mf_pause_screen]</visible>
		<animation effect="fade" time="200">VisibleChange</animation>
		<control type="image">
			<left>0</left><bottom>0</bottom><width>100%</width><height>260</height>
			<texture colordiffuse="99000000">moodyfin/shapes/grad_down.png</texture>
		</control>
		<include content="MFEndsAt"><param name="bottom" value="142" /></include>
		<control type="group">
			<centerleft>50%</centerleft><bottom>40</bottom><width>mf_osd_width</width><height>88</height>
			<include content="MFGlassPanel"><param name="height" value="88" /></include>
			<control type="group">
				<top>24</top><width>mf_osd_width</width><height>40</height>
				<include>MFPlayerProgress</include>
			</control>
			<!-- seeking with the number keys -->
			<control type="label">
				<left>0</left><top>-150</top><width>mf_osd_width</width><height>60</height>
				<align>center</align>
				<font>mf_heading48</font>
				<textcolor>mf_text</textcolor>
				<label>$INFO[Player.SeekNumeric]</label>
				<visible>!String.IsEmpty(Player.SeekNumeric)</visible>
			</control>
		</control>
		<!-- paused, before the pause screen -->
		<control type="label">
			<right>mf_gutter</right><bottom>52</bottom><width>300</width><height>60</height>
			<align>right</align><aligny>center</aligny>
			<font>font37</font>
			<textcolor>B3F1F2F4</textcolor>
			<label>Paused</label>
			<visible>Player.Paused</visible>
		</control>
		</control>
		<!-- pause screen (the Jellyfin theme's Netflix style): 3 s after pausing -->
		<control type="group" id="3100">
			<visible>$EXP[mf_pause_screen]</visible>
			<animation effect="fade" start="0" end="100" time="600">Visible</animation>
			<animation effect="fade" start="100" end="0" time="250">Hidden</animation>
			<control type="image">
				<left>0</left><top>0</top><width>100%</width><height>100%</height>
				<texture colordiffuse="8C000000">colors/white.png</texture>
			</control>
			<control type="image">
				<left>0</left><top>0</top><width>1400</width><height>100%</height>
				<texture colordiffuse="B3000000">moodyfin/shapes/grad_left.png</texture>
			</control>
			<control type="label">
				<left>150</left><top>330</top><width>1000</width><height>40</height>
				<font>font12</font>
				<textcolor>B3F1F2F4</textcolor>
				<label>You're watching</label>
			</control>
			<control type="image">
				<left>150</left><top>376</top><width>760</width><height>200</height>
				<aspectratio align="left" aligny="bottom">keep</aspectratio>
				<texture background="true">$VAR[MFPlayerLogo]</texture>
			</control>
			<control type="label">
				<left>150</left><top>376</top><width>1300</width><height>200</height>
				<aligny>bottom</aligny>
				<font>mf_heading120</font>
				<textcolor>mf_text</textcolor>
				<label>$VAR[MFPlayerTitle]</label>
				<visible>String.IsEmpty(Player.Art(clearlogo)) + String.IsEmpty(Player.Art(tvshow.clearlogo))</visible>
			</control>
			<control type="grouplist">
				<left>150</left><top>592</top><width>1300</width><height>40</height>
				<orientation>horizontal</orientation>
				<itemgap>22</itemgap>
				<usecontrolwidth>true</usecontrolwidth>
				<control type="label">
					<width>auto</width><height>40</height>
					<aligny>center</aligny>
					<font>mf_semibold22</font>
					<textcolor>E6F1F2F4</textcolor>
					<label>$VAR[MFPlayerSub]</label>
				</control>
				<control type="button">
					<top>5</top><width>auto</width><height>30</height>
					<label>$INFO[VideoPlayer.mpaa]</label>
					<font>font_flag</font>
					<textoffsetx>10</textoffsetx>
					<aligny>center</aligny>
					<disabledcolor>D9F1F2F4</disabledcolor>
					<texturenofocus border="5" colordiffuse="99F1F2F4">moodyfin/shapes/rr6_line.png</texturenofocus>
					<enable>false</enable>
					<visible>!String.IsEmpty(VideoPlayer.mpaa)</visible>
				</control>
				<control type="label">
					<width>auto</width><height>40</height>
					<aligny>center</aligny>
					<font>mf_semibold22</font>
					<textcolor>E6F1F2F4</textcolor>
					<label>$INFO[Player.Duration]</label>
				</control>
				<control type="label">
					<width>auto</width><height>40</height>
					<aligny>center</aligny>
					<font>mf_semibold22</font>
					<textcolor>E6F1F2F4</textcolor>
					<label>$INFO[VideoPlayer.Rating,★ ,]</label>
				</control>
			</control>
			<control type="textbox">
				<left>150</left><top>646</top><width>900</width><height>200</height>
				<font>font12</font>
				<textcolor>D9F1F2F4</textcolor>
				<label>$INFO[VideoPlayer.Plot]</label>
			</control>
			<control type="label">
				<right>130</right><bottom>110</bottom><width>400</width><height>60</height>
				<align>right</align><aligny>center</aligny>
				<font>font37</font>
				<textcolor>B3F1F2F4</textcolor>
				<label>Paused</label>
			</control>
		</control>
	</controls>
</window>
